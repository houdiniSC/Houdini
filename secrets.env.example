# Hermes secrets template — install-hermes.sh reads this file if present
# (copy it to secrets.env and fill the values; empty fields are asked interactively).
#
# IMPORTANT: these names are the SAME field names used in install-config.json
# and the encrypted .hcfg — no more SUBFINDER_* vs github confusion.
# One master key per service; each tool reads its own copy from its config file.

# DeepSeek API (required for the agent to work)
deepseek=

# Telegram bot (create via @BotFather — one bot per gateway)
bot=
users=                        # comma-separated numeric user IDs
home_channel=                 # optional: your GROUP "-100xxx" or "-100xxx:thread" — empty = auto-detect on first run
home_user=                    # optional: your private chat ID (same as your user ID, e.g. 123456789) — empty = auto-detect

# Search / web APIs
brave=
serpapi=

# Recon API keys (shared: subfinder + uncover + gh/git where noted)
github=                       # GitHub PAT (subfinder + gh/git)
virustotal=                   # VirusTotal (subfinder)
shodan=                       # Shodan (subfinder + uncover)
urlscan=                      # URLScan (subfinder)
dnsdumpster=                  # DNSDumpster (subfinder)
zoomeye=                      # ZoomEye host:key (subfinder + uncover)
fofa=                         # Fofa email:key (subfinder)

# Vulnerability databases
vulners=                      # Vulners
wpscan=                       # WPScan API token
nvd=                          # NVD API key (nuclei/nvd tool)

# Network & tunnels
ngrok=                        # ngrok authtoken
